@startuml
!theme cerulean
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Person(user, "Пользователь", "Или другой сервис через API Gateway")

System_Boundary(home_automation, "Система умного дома") {
  Container_Boundary(device_svc, "Device Management Service", "PHP / Laravel") {

    ' === Слой представления (API)
    Component("HTTP API Controller", "Laravel Controller", "<<Web>>", "REST API: GET /devices, PATCH /devices/{id}\nВалидация входных данных")

    ' === Слой приложения
    Component("Device Application Service", "Service", "<<Application>>", "Оркестрация: создать, обновить, активировать устройство\nТранзакции, события домена")

    ' === Доменный слой
    Component("Device", "Entity", "<<Domain>>", "ID, тип, статус (online/offline),\nпоследнее_состояние, комната")
    Component("DeviceRepository", "Interface", "<<Domain>>", "Абстракция для сохранения/поиска устройств")
    Component("DeviceFactory", "Factory", "<<Domain>>", "Создаёт Device с валидацией бизнес-правил")

    ' === Инфраструктурный слой
    Component("DeviceController", "Laravel Controller", "<<Web>>", "Проксирует запросы → Application Service")
    Component("EloquentDeviceRepository", "Repository", "<<Infrastructure>>", "Реализация DeviceRepository\nна основе Eloquent ORM")
    Component("DeviceEventPublisher", "Event Bus", "<<Infrastructure>>", "Публикует события (DeviceRegistered, DeviceStatusChanged)\n→ Redis/Kafka (упрощённо — sync в рамках монолита/VM)")

    ' === Внешние зависимости (если есть интеграция)
    Component("ExternalDeviceAdapter (ACL)", "Adapter", "<<Infrastructure>>", "Интеграция с физическими устройствами\n(например, HTTP/MQTT к шлюзу Zigbee)\nПреобразует внешние данные → Domain-объекты")

  }

  ' Внешняя система (реальный IoT-шлюз или эмулятор)
  System_Ext(iot_gateway, "IoT Gateway", "Шлюз устройств (Zigbee/MQTT/HTTP)")

  ' База данных
  ContainerDb(device_db, "Device DB", "PostgreSQL", "Хранение устройств и их состояний")
}

' Связи
Rel(user, device_svc, "Вызывает API", "HTTPS")

Rel_L("HTTP API Controller", "Device Application Service", "Вызывает", "sync")
Rel_L("Device Application Service", "DeviceFactory", "Создаёт", "sync")
Rel_L("Device Application Service", "DeviceRepository", "Сохраняет/ищет", "sync")
Rel_L("Device Application Service", "DeviceEventPublisher", "Публикует", "async/sync")

Rel_L("EloquentDeviceRepository", "Device DB", "Читает/пишет", "SQL")
Rel_L("EloquentDeviceRepository", "DeviceRepository", "«Реализует»", "interface")

Rel_L("ExternalDeviceAdapter (ACL)", "IoT Gateway", "Опрашивает/подписывается", "HTTP/MQTT")
Rel_L("Device Application Service", "ExternalDeviceAdapter (ACL)", "Получает данные", "sync/async (например, при обновлении статуса)")

@enduml